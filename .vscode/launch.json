{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pinterest Scraper: Debug Mode",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "args": [
                "-q", "test",
                "-n", "10",
                "--connect",
                "--auto-launch",
                "--debug"
            ],
            "python": "C:\\conda\\envs\\scraper\\python.exe",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": false,
            "pythonArgs": []
        },
        {
            "name": "Pinterest Scraper: Custom Args",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "args": [],
            "python": "C:\\conda\\envs\\scraper\\python.exe",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": false
        }
    ]
}
